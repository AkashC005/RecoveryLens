# RecoveryLens — environment configuration
#
#   cp .env.example .env
#   # then paste your key into .env
#
# .env is gitignored. .env.example is committed and must never contain a real
# key. Loaded automatically by api/__init__.py, so the values persist across
# terminals — no need to export anything before running uvicorn.
#
# Shell variables take precedence: anything already exported wins over .env.


# --------------------------------------------------------------------- key
# From https://console.anthropic.com -> Settings -> API Keys.
# Without it, all three features below degrade to deterministic behaviour.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5. Set to claude-haiku-4-5-20251001 if
# cost matters more than nuance — these tasks mostly restate retrieved text.
# RECOVERYLENS_LLM_MODEL=claude-sonnet-5


# ---------------------------------------------------------------- features
# All three default to OFF. Each degrades silently rather than erroring, which
# is safe but hard to notice — check GET /api/triage/status to see what is
# actually live.

# Agent chooses which guidance topics apply to this patient, and explains why.
# OFF: an if/else on risk tiers that inspects 4 of the 8 recorded deficits.
RECOVERYLENS_GUIDANCE_AGENT=1

# Generates clinician and caregiver text for each check-in, and prose answers
# in the Ask box.
# OFF: retrieved passages returned verbatim.
RECOVERYLENS_LLM_SYNTHESIS=1

# Reads caregiver free text and decides whether a clinician should see it.
# OFF: three boolean checks only; free text is stored and never read.
RECOVERYLENS_TRIAGE_AGENT=1


# ---------------------------------------------------------------- messaging
# Unset, or anything other than "twilio", uses ConsoleSender: check-ins are
# printed to the server log and nothing is sent. That is the default so a
# missing variable can never result in real messages going to a real family.
# RECOVERYLENS_MESSAGING=twilio

# From console.twilio.com. TWILIO_FROM must carry the whatsapp: prefix for
# WhatsApp — Twilio treats whatsapp:+1415... and +1415... as different channels
# and mismatching them fails with an unhelpful error.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886

# Your public webhook URL, exactly as configured in the Twilio console. Used for
# signature validation; if unset, the URL Starlette reconstructs is used, which
# can differ behind a proxy or tunnel and cause valid requests to be rejected.
# NOTE: ngrok's free URL changes on every restart — update BOTH this and the
# Twilio console, or inbound replies silently stop while sending still works.
# TWILIO_WEBHOOK_URL=https://your-ngrok-id.ngrok-free.dev/api/webhooks/twilio

# Background sending of scheduled check-ins. OFF by default: a job that messages
# patients' families unattended should never start because someone forgot to
# turn it off. Without it, check-ins are sent manually via
# POST /api/checkins/{id}/send and nothing goes out on its own.
#
# When on: polls every 15 minutes for check-ins whose date has arrived, sends
# each through the same policy gate as the API, and every 30 minutes escalates
# voice transcripts a carer never confirmed. Never sends early, never sends
# twice, capped at 25 per run.
# RECOVERYLENS_SCHEDULER=1


# ------------------------------------------------------------ outbound voice
# Where Twilio can reach this server to FETCH generated audio. Twilio downloads
# media from its own servers, so this must be a public address — your ngrok URL
# locally, or the deployed one. Same requirement as TWILIO_WEBHOOK_URL, and the
# same failure if it drifts: sends still work, they just arrive without audio.
#
# Unset means text-only. Audio is an enhancement; a missing base URL must never
# stop a check-in reaching a family. `POST /api/checkins/{id}/send` reports what
# happened under "audio", so text-only is visible rather than assumed.
#
# Needs RECOVERYLENS_VOICE set as well — the same provider does TTS and STT.
#
# The audio is served from /media/{token}: a 256-bit token as the only
# credential, 15-minute expiry, no listing route, no caching, and the patient
# reference stripped before synthesis so a leaked URL yields generic guidance
# rather than guidance about an identifiable person. See api/media.py.
# RECOVERYLENS_PUBLIC_URL=https://your-ngrok-id.ngrok-free.dev


# -------------------------------------------------------------- translation
# Caregiver messages in Tamil or Hindi. Clinician-facing text and every quoted
# guideline excerpt stay English regardless — a translated NICE recommendation is
# no longer a quotation, and guidance/translate.py refuses to produce one.
#
# Set the language per patient (`caregiver_language` on the assessment, stored as
# Patient.language). This flag only controls whether translation is attempted.
#
# Every translation is round-tripped back to English and checked before it is
# sent. Two things are verified, and they are the two a similarity score cannot
# see: every number must survive ("14 days" must not become "4 days"), and the
# negation count must not fall ("do not stop the tablets" must not become "stop
# the tablets"). On any doubt the ENGLISH original is sent and the reason is
# recorded on the check-in. A message the carer cannot read is a delivery problem
# a clinician can see; a fluent mistranslation is a clinical one nobody sees.
#
# Uses the same ANTHROPIC_API_KEY as the other agents. Two calls per message.
# RECOVERYLENS_TRANSLATE=1


# --------------------------------------------------------------- embeddings
# Semantic search over the guidance corpus, blended with TF-IDF.
#
# Fixes the vocabulary mismatches TF-IDF structurally cannot: asking "how do I
# prevent falls?" against a corpus that says "recognise the complications ...
# including frequent falls". Uses an embedding API rather than
# sentence-transformers, which would pull ~2GB of torch onto a 512MB target.
#
# Setup:
#   1. pip install openai
#   2. Key from platform.openai.com — NOT chat.openai.com. ChatGPT Plus and the
#      API are separate products with separate billing; a ChatGPT subscription
#      gives you no API access. New API accounts get $5 free credit, no card.
#   3. Set the two variables below
#   4. python -m guidance.embeddings   (one-off; embedding 291 chunks costs
#                                       ~$0.0003, then cached to disk)
#   5. python -m guidance.tune_floor   (measures EMBED_FLOOR for your corpus —
#                                       the default is a guess, not a measurement)
#
# Without the cache the retriever falls back to TF-IDF and says so at startup.
# RECOVERYLENS_EMBEDDINGS=1
# OPENAI_API_KEY=
# RECOVERYLENS_EMBED_MODEL=text-embedding-3-small

# The provider is inferred from whichever key is present, so this is only needed
# if both are set. Voyage is Anthropic's recommended embeddings partner and is
# supported if you would rather not add an OpenAI account.
# RECOVERYLENS_EMBED_PROVIDER=openai
# VOYAGE_API_KEY=


# -------------------------------------------------------------------- voice
# Unset uses NullSpeech: voice notes are not transcribed and carers reply by
# text. Voice must be configured deliberately.
# RECOVERYLENS_VOICE=openai
# OPENAI_API_KEY=

# Optional model overrides.
# RECOVERYLENS_STT_MODEL=whisper-1
# RECOVERYLENS_TTS_MODEL=tts-1
# RECOVERYLENS_TTS_VOICE=alloy

# Nothing a carer says by voice is recorded until they confirm the transcript.
# Speech recognition drops negations most readily — "he can't move his arm"
# becomes "he can move his arm", which reads as reassuring and would not be
# caught downstream. Unconfirmed transcripts escalate to a clinician rather than
# closing the check-in.


# --------------------------------------------------------------- deployment
# DATABASE_URL=sqlite:///./recoverylens.db
# ALLOWED_ORIGINS=http://localhost:5173


# What none of these change: predictions always come from the trained models,
# never an LLM. Guidance excerpts are always verbatim and cited. Agents choose
# and explain; they never write clinical text.
